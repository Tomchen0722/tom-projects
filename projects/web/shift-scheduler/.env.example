# 複製這個檔案成 .env,再把值填進去。沒填的話系統跑 demo 模式,網頁功能不受影響。

# Flask session 加密用,正式上線請換成隨機字串
SECRET_KEY=change-me-in-production

# 後台管理密碼(老闆用)
ADMIN_PASSWORD=admin1234

# ---- LINE Messaging API ----
# LINE Developers > Messaging API channel > Channel secret
LINE_CHANNEL_SECRET=
# LINE Developers > Messaging API channel > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Developers > LIFF > LIFF ID,格式像 1234567890-abcdefgh
LINE_LIFF_ID=
# LIFF 所屬的 LINE Login channel 的 Channel ID(純數字),用來驗證員工身分
LINE_LOGIN_CHANNEL_ID=

# 對外網址(LINE 推播的班表連結會用到),本機測試可用 ngrok 網址
PUBLIC_BASE_URL=http://127.0.0.1:5000
