# 複製這個檔案成 .env,再把值填進去。沒填的話系統跑 demo 模式,網頁功能不受影響。

# Flask session 加密用,正式上線請換成隨機字串
SECRET_KEY=change-me-in-production

# 後台管理密碼(老闆用)
ADMIN_PASSWORD=admin1234

# ---- 資料庫 (Supabase) ----
# 填了就用 Supabase,不填就用本機 data/shift.db(SQLite)。
#
# 位址要去 Supabase 後台 > Project Settings > Database > Connection string
# 選 【Connection pooling】那一段,不要用上面的 Direct connection。
#
# 重要:Direct connection 的主機 db.xxxxx.supabase.co 只有 IPv6 位址,
#       這台電腦沒有對外 IPv6,填了一定連不上。
#
# 正確的長相(注意主機名有 pooler,使用者名稱是 postgres.專案代號):
# SUPABASE_DB_URL=postgresql://postgres.abcdefghijk:你的密碼@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# 密碼裡如果有 / @ # ? & 這些符號,程式會自動幫你編碼,直接貼原始密碼即可。
# 從後台複製時常會連 [YOUR-PASSWORD] 一起帶上,記得換成真正的密碼。
SUPABASE_DB_URL=

# 連線池大小與連線逾時秒數,一般不用改
DB_POOL_SIZE=8
DB_CONNECT_TIMEOUT=10

# ---- LINE Messaging API ----
# LINE Developers > Messaging API channel > Channel secret
LINE_CHANNEL_SECRET=
# LINE Developers > Messaging API channel > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Developers > LIFF > LIFF ID,格式像 1234567890-abcdefgh
LINE_LIFF_ID=
# LIFF 所屬的 LINE Login channel 的 Channel ID(純數字),用來驗證員工身分
LINE_LOGIN_CHANNEL_ID=

# 對外網址(LINE 推播的班表連結會用到),本機測試可用 ngrok 網址
PUBLIC_BASE_URL=http://127.0.0.1:5000
